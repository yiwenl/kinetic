{
  "name": "kinetic",
  "version": "1.0.0",
  "description": "Skeleton tracking module",
  "main": "dist/kinetic.cjs",
  "module": "dist/kinetic.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kinetic.esm.js",
